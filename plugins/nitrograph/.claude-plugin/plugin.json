  "license": "MIT",
  "keywords": [
    "mcp",
    "discovery",
    "agents",
    "x402",
    "mpp",
    "paid-apis",
    "call-cards",
    "service-registry"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "nitrograph": {
      "command": "npx",
      "args": ["-y", "nitrograph@0.5.4", "server"]
    }
  }

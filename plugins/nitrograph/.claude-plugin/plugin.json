{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nitrograph",
  "version": "1.0.0",
  "description": "Discover, inspect, and call agent-usable APIs across x402, MPP, and other paid API rails via Nitrograph.",
  "author": {
    "name": "Nitrograph",
    "email": "eric@nitrograph.com",
    "url": "https://nitrograph.com"
  },
  "homepage": "https://nitrograph.com",
